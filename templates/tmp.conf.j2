#jinja2: trim_blocks: True, lstrip_blocks: True
{{ ansible_managed | comment }}
# =============================================================================
# /tmp tmpfiles.d Configuration
# =============================================================================
# Managed by the os_customize role. Replaces /usr/lib/tmpfiles.d/tmp.conf;
# entries for other paths (such as /var/tmp) are carried over unchanged.
# =============================================================================

D /tmp 1777 root root {{ os_customize_tmp_max_age }}
{% for path in os_customize_tmp_exclude_paths %}
x {{ path }}
{% endfor %}
{% if __os_customize_tmp_vendor_lines | length > 0 %}

# Carried over unchanged from /usr/lib/tmpfiles.d/tmp.conf
{% for line in __os_customize_tmp_vendor_lines %}
{{ line }}
{% endfor %}
{% endif %}
